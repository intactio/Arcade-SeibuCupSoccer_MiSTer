<misterromdescription>
  <name>Seibu Cup Soccer :Selection: (set 1)</name>
  <setname>cupsocs</setname>
  <mameversion>0289</mameversion>
  <rbf>SeibuCupSoccer</rbf>
  <year>1992</year>
  <manufacturer>Seibu Kaihatsu</manufacturer>
  <category>Sports</category>
  <rotation>horizontal</rotation>
  <resolution>15kHz</resolution>
  <players>4</players>
  <joystick>8-way</joystick>
  <num_buttons>2</num_buttons>
  <buttons default="A,B,Start" names="Shoot/Tackle,Pass,-,-,-,-,Start,Coin,Pause"/>

  <switches default="FF,FF,FF,FF">
    <dip bits="0,2"   ids="4C 1C,3C 1C,2C 1C,1C 6C,1C 4C,1C 3C,1C 2C,1C 1C"   name="Coin 1"/>
    <dip bits="3,5"   ids="4C 1C,3C 1C,2C 1C,1C 6C,1C 4C,1C 3C,1C 2C,1C 1C"   name="Coin 2"/>
    <dip bits="6"     ids="x2,Normal"                                          name="Starting Coin"/>
    <dip bits="7"     ids="On,Off"                                             name="Flip Screen"/>
    <dip bits="8,9"   ids="3:00,2:30,1:30,2:00"                                name="Time vs CPU (1P)"/>
    <dip bits="10,11" ids="2:00,3:00,2:00,2:30"                                name="Time P vs P (2P)"/>
    <dip bits="12,13" ids="2:30,3:30,2:30,3:00"                                name="Time P vs P (3P)"/>
    <dip bits="14,15" ids="3:00,4:00,3:00,3:30"                                name="Time P vs P (4P)"/>
    <dip bits="16,17" ids="Very Hard,Hard,Easy,Normal"                         name="Difficulty"/>
    <dip bits="18,19" ids="4P 1 Coin,4P Linked,4P 4 Coin,2 Players" name="Cabinet Setting"/>
    <dip bits="20"    ids="No,Yes"                                             name="Demo Sounds"/>
    <dip bits="21"    ids="On,Off"                                             name="Service Mode"/>
  </switches>
  <!-- Variant 03 = Selection: $0FFFFA debug-text patch + Selection CRTC/I/O map.
       Sent before the main ROM stream. -->
  <rom index="1">
    <part>03</part>
  </rom>
  <rom index="0" zip="cupsocs.zip|cupsoc.zip" md5="None">
    <!-- MAIN @ 0x000000: preserve the existing core's 68K byte lanes. -->
    <interleave output="32">
      <part name="1_10n.bin" crc="b67835c5" map="0010"/>
      <part name="2_10q.bin" crc="de65509c" map="0001"/>
      <part name="3_10f.bin" crc="c0333f0c" map="1000"/>
      <part name="4_10k.bin" crc="288f11d4" map="0100"/>
    </interleave>

    <!-- CHAR @ 0x100000 -->
    <interleave output="16">
      <part name="6_7x.bin" crc="7981366e" map="01"/>
      <part name="5_7y.bin" crc="26cbfaf0" map="10"/>
    </interleave>

    <!-- BACK @ 0x120000 -->
    <interleave output="16"><part name="back-1.4y" crc="3dfea0ec" map="21"/></interleave>

    <!-- FORE @ 0x220000 -->
    <interleave output="16"><part name="back-2.6y" crc="e07712af" map="21"/></interleave>
    <part repeat="0x80000">00</part>

    <!-- SPRITE @ 0x320000 -->
    <interleave output="16"><part name="obj.8c" crc="e2377895" map="21"/></interleave>
    <part repeat="0x500000">00</part>

    <!-- OKI @ 0x920000 -->
    <interleave output="16"><part name="8_7a.bin" crc="6f594808" map="21"/></interleave>
    <part repeat="0x40000">00</part>

    <!-- AUDIOCPU @ 0x9A0000: complete 64KB Z80 file -->
    <interleave output="16"><part name="seibu7.8a" crc="f63329f9" map="21"/></interleave>
    <part repeat="0x10000">00</part>

    <!-- COPX @ 0x9C0000 -->
    <interleave output="16"><part name="copx-d1.bin" crc="029bc402" map="21"/></interleave>
  </rom>

  <mratimestamp>20261017000000</mratimestamp>
</misterromdescription>
